# Copy to .env.local. Values come from the dev Supabase project: Project Settings → API Keys / Data API.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Every auth redirect is built from this; it must be on Supabase's redirect allow-list.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
