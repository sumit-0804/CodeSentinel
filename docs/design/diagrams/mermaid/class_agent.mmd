%%{init: {"theme":"base","themeVariables":{"primaryColor":"#d9f0e1","primaryBorderColor":"#2f9e5e","lineColor":"#6b7280","primaryTextColor":"#1a1a1a"}} }%%
classDiagram
    direction TB

    class ReviewAgent {
        <<interface>>
        +review(AgentReviewRequest) AgentReviewResponse
        +capabilities() Capabilities
        +health() Health
    }

    class BaseAgentService {
        <<abstract>>
        #agentKind : AgentKind
        #maxDiffBytes : int
        +review(AgentReviewRequest) AgentReviewResponse
        #analyze(ChangedFile)* Finding[]
        #detectLanguage(ChangedFile) Language
        #skip(ChangedFile, reason) void
        #runLlmPass(ChangedFile[], LlmPassOptions) Finding[]
    }

    class SecurityAgent {
        -sastRules : RuleSet
        -secretPatterns : PatternSet
        #analyze(ChangedFile[]) Finding[]
        -scanInjection(addedLine) Finding[]
        -scanSecrets(addedLine) Finding[]
    }

    class StyleAgent {
        -dispatcher : LinterDispatcher
        #analyze(ChangedFile) Finding[]
        +applyFixes(ChangedFile[]) PatchedFile[]
    }

    class PerformanceAgent {
        -prompt : LlmPassOptions
        #analyze(ChangedFile[]) Finding[]
    }

    class LogicAgent {
        -prompt : LlmPassOptions
        #analyze(ChangedFile[]) Finding[]
    }

    class DocumentationAgent {
        -prompt : LlmPassOptions
        #analyze(ChangedFile[]) Finding[]
        -keepDocstringRules(Finding[]) Finding[]
    }

    class LinterDispatcher {
        +forLanguage(Language) Linter[]
        -eslint : Linter
        -prettier : Linter
        -ruff : Linter
        -black : Linter
    }

    class DockerSandbox {
        -cpuLimit : string
        -memoryLimit : string
        -networkDisabled : boolean
        +run(command, files) SandboxResult
    }

    class LlmClient {
        +complete(LlmRequest) LlmResponse
    }

    ReviewAgent <|.. BaseAgentService
    BaseAgentService <|-- SecurityAgent
    BaseAgentService <|-- StyleAgent
    BaseAgentService <|-- PerformanceAgent
    BaseAgentService <|-- LogicAgent
    BaseAgentService <|-- DocumentationAgent

    StyleAgent *-- LinterDispatcher
    LinterDispatcher --> DockerSandbox : runs every linter inside

    SecurityAgent --> LlmClient
    PerformanceAgent --> LlmClient
    LogicAgent --> LlmClient
    DocumentationAgent --> LlmClient

    note for ReviewAgent "All five services implement this one contract,<br/>which is what lets each be called, tested and<br/>reused independently (FR-SEC-04, NFR-10)."
    note for LogicAgent "Logic, Performance and Documentation have no rules:<br/>one LLM call over the whole changed files, linked<br/>files together, findings only on added lines.<br/>No LLM answer fails the run (503 llm_failed)."
    note for StyleAgent "The only agent with no LlmClient. Its fixes are<br/>rule-based and therefore safe to apply without<br/>developer review (NFR-07)."
