# Copy to .env (local) and .env.production (loaded when NODE_ENV=production). Both are gitignored.

# Port the gateway listens on, integer in 1..65535.
PORT=3000

# Base URL of the orchestrator service, http or https. Required.
ORCHESTRATOR_URL=http://orchestrator.internal:8080

# Timeout for each orchestrator call in ms, integer in 1000..30000.
ORCHESTRATOR_TIMEOUT_MS=5000

# Bearer token sent to the orchestrator on every call. Required.
SERVICE_TOKEN=replace-with-service-token

# HS256 key that signs the cs_session cookie JWT. At least 32 characters.
JWT_SECRET=replace-with-32-plus-random-characters

# Secret configured on the GitHub App webhook; verifies X-Hub-Signature-256. At least 16 characters.
GITHUB_WEBHOOK_SECRET=replace-with-webhook-secret

# none in every deployed environment (dev is refused when NODE_ENV=production); dev loads demo data.
GATEWAY_SEED=none
