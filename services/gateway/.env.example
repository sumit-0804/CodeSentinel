# Copy to .env (local) and .env.production (loaded when NODE_ENV=production). Both are gitignored.

# Port the gateway listens on, integer in 1..65535.
PORT=3000

# Base URL of the orchestrator service, http or https. Required.
ORCHESTRATOR_URL=http://orchestrator.internal:8080

# Timeout for each orchestrator call in ms, integer in 1000..30000.
ORCHESTRATOR_TIMEOUT_MS=5000

# How long to wait for a review job before its Check Run is completed as timed out, in ms (10000..1800000).
REVIEW_POLL_TIMEOUT_MS=300000

# Bearer token sent to the orchestrator on every call. Required.
SERVICE_TOKEN=replace-with-service-token

# Bearer token for GET /metrics (Prometheus / Grafana Cloud). At least 16 characters; unset = no /metrics route.
METRICS_TOKEN=

# Supabase project URL. Dashboard access tokens are verified against its JWKS (ES256), and signing
# in needs DATABASE_URL too, for the session check. Unset = every /v1 call is 401.
# Required when NODE_ENV=production. Example: https://<project-ref>.supabase.co
SUPABASE_URL=

# The dashboard's base URL. Set → Apply all fixes comments on GitHub link to the review's page and to sign-in.
# Example: https://codesentinel.scribly.fun (dev: http://localhost:3001)
DASHBOARD_URL=

# Minutes an authenticator (TOTP) code counts for on repository, agent and GitHub changes (1..60).
MFA_STEP_UP_MINUTES=10

# Changed files up to this many bytes are sent to the agents whole, so they read each change in
# context; larger files go as diffs only. 0 sends diffs only (0..1000000).
FILE_CONTENT_MAX_BYTES=36000

# Rate limits (FR-GW-05): webhooks per installation, /v1 per user, /v1 writes per user (all per
# minute), and failed sign-ins per IP address per 15 minutes. Over a limit answers 429 rate_limited.
RATE_LIMIT_WEBHOOK_PER_MIN=300
RATE_LIMIT_USER_PER_MIN=120
RATE_LIMIT_WRITE_PER_MIN=20
RATE_LIMIT_FAILED_AUTH_PER_15_MIN=20

# Proxy hops in front of the gateway, counting the dashboard (it forwards the browser's IP in
# X-Forwarded-For): 1 locally, 2 on Render (Render's proxy + the dashboard). 0 trusts none (0..10).
TRUST_PROXY=1

# Secret configured on the GitHub App webhook; verifies X-Hub-Signature-256. At least 16 characters.
GITHUB_WEBHOOK_SECRET=replace-with-webhook-secret

# none in every deployed environment (dev is refused when NODE_ENV=production); dev loads demo data.
# Must be none when DATABASE_URL is set; seed a database with `npm run seed -w @code-sentinel/db`.
GATEWAY_SEED=none

# Supabase Postgres, session pooler (port 5432), as the `prisma` role. Unset = in-memory stores.
# Required when NODE_ENV=production. Example:
# postgresql://prisma.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# GitHub App (set both, or neither to use the stub client). Required when NODE_ENV=production.
# The key path is relative to services/gateway/; *.pem is gitignored.
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=

# Connecting GitHub from the dashboard (set all three, or none: linking then answers 503). Required when
# NODE_ENV=production. Client ID and a generated client secret come from the App's General settings.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Seals GitHub user tokens at rest (AES-256-GCM): 32 random bytes, base64. Generate one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=

# Dev only: point the seeded repository at a real repo, as owner/name:githubRepoId.
GATEWAY_DEV_REPOSITORY=
