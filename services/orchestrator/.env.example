# Base URL of each agent service. Leave one unset and that agent is recorded as skipped (agent_not_configured).
AGENT_SECURITY_URL=http://security-agent.internal:8081
AGENT_STYLE_URL=http://style-agent.internal:8082
AGENT_PERFORMANCE_URL=http://performance-agent.internal:8083
AGENT_LOGIC_URL=http://logic-agent.internal:8084
AGENT_DOCUMENTATION_URL=http://documentation-agent.internal:8085

# Port the orchestrator listens on, integer in 1..65535.
PORT=8080

# Shared internal bearer token. Required: the gateway must send it on every /internal call, and it is
# also sent to every agent. Use the same value as the gateway's SERVICE_TOKEN.
SERVICE_TOKEN=replace-with-service-token

# Supabase Postgres, session pooler (port 5432), as the `prisma` role; the same value as the gateway's.
# Set → reviews are stored in the `reviews` table and survive restarts; unset → in memory.
# Required when NODE_ENV=production. Example:
# postgresql://prisma.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# In memory only: how long a finished review job stays readable, in ms, 60000..86400000 (default 1 hour).
JOB_RETENTION_MS=3600000

# Default per-agent timeout in ms, integer in 1000..120000. A review job's agentTimeoutMs overrides it.
AGENT_TIMEOUT_MS=20000

# Minimum timeout for LLM agents in ms, integer in 1000..120000. A Gemini call can take over 20 s.
LLM_AGENT_TIMEOUT_MS=45000

# LLM providers: Groq first, Gemini second. A provider is used only when its key is set; with neither,
# LLM agents run their rule-based checks only. Set the limits to the quota page of THIS environment's key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Groq limits are per account (organization), not per key. An agent whose .env holds another
# account's GROQ_API_KEY gets that account's name here, so it gets its own quota budget; agents
# that share a name share one budget. Unset is `default`, the account of the key above.
GROQ_ACCOUNT_SECURITY=
GROQ_ACCOUNT_PERFORMANCE=
GROQ_ACCOUNT_LOGIC=
GROQ_ACCOUNT_DOCUMENTATION=
GROQ_RPM=30
GROQ_TPM=8000
GROQ_RPD=1000
GROQ_TPD=200000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_RPM=15
GEMINI_TPM=250000
GEMINI_RPD=500

# Embeddings stay off until all three limits are set.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBED_RPM=
GEMINI_EMBED_TPM=
GEMINI_EMBED_RPD=

# Share of every limit used, and batch sizes (tokens are estimated as bytes / 3). A file over
# LLM_MAX_FILE_TOKENS is reviewed from its diff; linked files share a batch of up to LLM_MAX_BATCH_TOKENS.
LLM_QUOTA_HEADROOM=0.8
LLM_MAX_OUTPUT_TOKENS=2000
LLM_MAX_FILE_TOKENS=12000
LLM_MAX_BATCH_TOKENS=40000
LLM_REVIEW_MAX_TOKENS=80000
# Diffs of the pull request's other changed files sent with each call, so linked changes are read together.
LLM_OTHER_CHANGES_TOKENS=4000
LLM_PROMPT_RESERVE_TOKENS=1000
