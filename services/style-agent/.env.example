# Copy to .env (local) and .env.production (loaded when NODE_ENV=production). Both are gitignored.

# Port the agent listens on, integer in 1..65535.
PORT=8082

# Bearer token required on POST /v1/review. Same value as the orchestrator's SERVICE_TOKEN.
SERVICE_TOKEN=replace-with-service-token

# Bearer token for GET /metrics (Prometheus / Grafana Cloud). At least 16 characters; unset = no /metrics route.
METRICS_TOKEN=

# docker (one container per request) or process (linters run in this service's image; Render).
SANDBOX_MODE=docker

# Docker mode: sandbox image built with `npm run sandbox:build -w @code-sentinel/style-agent`.
STYLE_SANDBOX_IMAGE=code-sentinel/style-sandbox:1

# Process mode: folder holding run.mjs and the linters' node_modules (the service image's /opt/lint).
LINT_ROOT=
