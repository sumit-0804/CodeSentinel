# Copy to .env (local) and .env.production (loaded when NODE_ENV=production). Both are gitignored.

# Port the agent listens on, integer in 1..65535.
PORT=8082

# Bearer token required on POST /v1/review. Same value as the orchestrator's SERVICE_TOKEN.
SERVICE_TOKEN=replace-with-service-token

# Sandbox image built with `npm run sandbox:build -w @code-sentinel/style-agent`.
STYLE_SANDBOX_IMAGE=code-sentinel/style-sandbox:1
