# Copy to .env (local) and .env.production (loaded when NODE_ENV=production). Both are gitignored.

# Port the agent listens on, integer in 1..65535.
PORT=8084

# Bearer token required on POST /v1/review. Same value as the orchestrator's SERVICE_TOKEN.
SERVICE_TOKEN=replace-with-service-token

# Bearer token for GET /metrics (Prometheus / Grafana Cloud). At least 16 characters; unset = no /metrics route.
METRICS_TOKEN=

# LLM keys and limits (see packages/llm/README.md). This agent has no rules: without a key every review run
# fails with 503 llm_unavailable. GROQ_API_KEY may be another Groq account's key, so this agent has its own
# quota; name that account in the orchestrator's GROQ_ACCOUNT_LOGIC.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_MAX_OUTPUT_TOKENS=2000
# Must match the orchestrator's LLM_MAX_BATCH_TOKENS and LLM_OTHER_CHANGES_TOKENS, or larger batches are refused.
LLM_MAX_BATCH_TOKENS=40000
LLM_OTHER_CHANGES_TOKENS=4000
LLM_PROMPT_RESERVE_TOKENS=1000
