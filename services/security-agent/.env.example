# Copy to .env (local) and .env.production (loaded when NODE_ENV=production). Both are gitignored.

# Port the agent listens on, integer in 1..65535.
PORT=8081

# Bearer token required on POST /v1/review. Same value as the orchestrator's SERVICE_TOKEN.
SERVICE_TOKEN=replace-with-service-token

# LLM keys and limits (see packages/llm/README.md). Without either key the agent runs its rules only;
# the orchestrator decides per request which provider may be used.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_MAX_OUTPUT_TOKENS=2000
LLM_MAX_BATCH_TOKENS=12000
LLM_PROMPT_RESERVE_TOKENS=1000
