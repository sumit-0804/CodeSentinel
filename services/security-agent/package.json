{
  "name": "@code-sentinel/security-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Security Agent: SAST rules and secret detection on changed lines, plus an LLM pass on the provider the orchestrator reserved.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@code-sentinel/agent-kit": "*",
    "@code-sentinel/contracts": "*",
    "@code-sentinel/llm": "*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
