{
  "name": "@code-sentinel/agent-kit",
  "version": "0.0.0",
  "private": true,
  "description": "Shared base for the five agent services: the agent.yaml HTTP contract, per-file skips, deadline, diff parsing.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@code-sentinel/contracts": "*",
    "@code-sentinel/llm": "*",
    "@code-sentinel/service-kit": "*",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
