# Copy to .env (gitignored). Read by prisma.config.ts for the Prisma CLI (migrate, seed, generate).

# Supabase session pooler (port 5432) as the dedicated `prisma` user: Project -> Connect -> Session pooler.
# Format: postgres://prisma.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgres://prisma.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Used by migrations; the session pooler works, so it can equal DATABASE_URL.
DIRECT_URL=postgres://prisma.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
